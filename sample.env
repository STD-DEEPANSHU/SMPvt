# Telegram API Credentials (from https://my.telegram.org)
API_ID=1234567
API_HASH=your_api_hash_here

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Telegram User ID of the Bot Owner
OWNER_ID=6073400587

# Space-separated list of Sudo user IDs
SUDO_USERS=6073400587

# Assistant Pyrogram Session String (for playing audio in Voice Chat)
SESSION_STRING=your_pyrogram_session_string_here

# MongoDB Connection URI (Optional)
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Playback Settings
DURATION_LIMIT=3600
AUTO_LEAVE_TIME=60

# StdAPI Configuration (Optional, defaults to https://stdapi.vercel.app)
STDAPI_BASE_URL=https://stdapi.vercel.app
STDAPI_KEY=
