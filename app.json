{
  "name": "StdMusic",
  "description": "High-performance Telegram Voice Chat Music Bot powered by StdGram, PyTgCalls, and StdAPI.",
  "logo": "https://graph.org/file/f4b16beae1579beab1479.jpg",
  "keywords": ["telegram", "music", "voicechat", "pytgcalls", "stdgram", "stdapi", "bot"],
  "repository": "https://github.com/STD-DEEPANSHU/StdMusic",
  "website": "https://github.com/STD-DEEPANSHU/StdMusic",
  "success_url": "https://t.me/TeamStdNetwork",
  "stack": "container",
  "env": {
    "API_ID": {
      "description": "Your Telegram API ID from https://my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "Your Telegram API Hash from https://my.telegram.org",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Your Bot Token from @BotFather",
      "required": true
    },
    "OWNER_ID": {
      "description": "Telegram user ID of the Bot Owner",
      "required": true
    },
    "SESSION_STRING": {
      "description": "Pyrogram / StdGram session string for assistant userbot",
      "required": true
    },
    "SUDO_USERS": {
      "description": "Space-separated user IDs of Sudo Admins",
      "required": false
    },
    "MONGO_URL": {
      "description": "MongoDB connection string URI",
      "required": false
    },
    "DURATION_LIMIT": {
      "description": "Maximum song duration in seconds (default 3600)",
      "value": "3600",
      "required": false
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    },
    {
      "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest.git"
    }
  ],
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  }
}
